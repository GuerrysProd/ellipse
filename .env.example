# Webhook qui reçoit chaque demande validée (CRM, Brevo, n8n…). Sans valeur : acceptée en développement, refusée en production.
LEAD_WEBHOOK_URL=

# "true" sur une préversion sans webhook : les demandes sont acceptées sans être transmises, les simulateurs affichent
# leur résultat, et chaque formulaire le signale. Sans effet dès que LEAD_WEBHOOK_URL est renseigné. À retirer au lancement.
LEAD_DEMO_MODE=false

# Passer à "true" le jour de la mise en ligne. Tant que ce n'est pas le cas, le site demande aux moteurs de ne pas l'indexer.
NEXT_PUBLIC_SITE_INDEXABLE=false

# "false" masque les encadrés « À compléter » destinés à la relecture.
NEXT_PUBLIC_SHOW_TODOS=true

# Identifiant Google Tag Manager (GTM-XXXXXXX). Sans valeur, aucun script de mesure n'est chargé.
NEXT_PUBLIC_GTM_ID=
